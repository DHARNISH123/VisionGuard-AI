# ================================
# VisionGuard AI - Production Environment
# ================================

# Application
PROJECT_NAME="VisionGuard AI"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="b7464aaf5f3fe3b52f7d114f1e985f90"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =====================================
# Database
# =====================================
# SQLite (Recommended for Demo)
DATABASE_URL="sqlite:///./visionguard.db"

# If using PostgreSQL later, replace with:
# DATABASE_URL="postgresql://username:password@host:5432/visionguard"

# =====================================
# Upload Directory
# =====================================
# Local development
# UPLOAD_DIR="./uploads"

# Render Production
UPLOAD_DIR="/opt/render/project/src/uploads"

# =====================================
# Frontend URL (CORS)
# =====================================
FRONTEND_URL="https://visionguardai-five.vercel.app"

# =====================================
# Gemini AI
# =====================================
GEMINI_API_KEY=""

# =====================================
# AWS S3 (Optional)
# =====================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# =====================================
# Environment
# =====================================
ENVIRONMENT="production"
DEBUG=False

# =====================================
# Logging
# =====================================
LOG_LEVEL="INFO"

# =====================================
# Server
# =====================================
HOST="0.0.0.0"
PORT=8000